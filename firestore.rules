rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches request.auth.uid)
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - displayName: string (optional) - User's display name
    //   - email: string (required) - User's email address
    //   - photoURL: string (optional) - User's profile photo URL
    //   - role: string (required) - ['user', 'admin']
    //
    // Collection: tracks
    // Document ID: {trackId}
    // Fields:
    //   - id: string (required) - Unique identifier
    //   - title: string (required) - Track title
    //   - artist: string (required) - Artist name
    //   - album: string (optional) - Album name
    //   - coverUrl: string (optional) - URL to cover art
    //   - audioUrl: string (required) - URL to audio file
    //   - duration: number (optional) - Duration in seconds
    //   - userId: string (required) - ID of the user who uploaded the track
    //   - createdAt: timestamp (required) - Creation timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "griffinhenry668@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['user', 'admin'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500));
    }

    function isValidTrack(data) {
      return data.keys().hasAll(['title', 'artist', 'audioUrl', 'userId', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() < 200 &&
             data.audioUrl is string && data.audioUrl.size() < 1000 &&
             data.userId == request.auth.uid &&
             data.createdAt is timestamp &&
             (!('album' in data) || (data.album is string && data.album.size() < 200)) &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() < 1000)) &&
             (!('duration' in data) || (data.duration is number && data.duration >= 0));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /tracks/{trackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidTrack(request.resource.data);
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && isValidTrack(request.resource.data)) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }
  }
}
